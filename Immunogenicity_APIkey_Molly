import os
import json
import re
import time
from pathlib import Path

from google.colab import files
from openpyxl import load_workbook
from openpyxl.styles import Alignment
from openpyxl.utils import get_column_letter
from openai import OpenAI
from tqdm import tqdm

# =========================
# CONFIG
# =========================

MODEL = os.getenv("OPENAI_MODEL", "gpt-5.5")
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY", "").strip()

if not OPENAI_API_KEY:
    OPENAI_API_KEY = "PASTE_YOUR_OPENAI_API_KEY_HERE"

MAX_RETRIES = 3
RETRY_SLEEP_SECONDS = 3

NOTE_HEADER_PREFIX = "Immunological Notes from Clinical Trial "
NO_TRIALS_TEXT = "No relevant clinical immunogenicity trials found."

# If your installed SDK uses a different tool name, adjust this one line.
WEB_SEARCH_TOOL = {"type": "web_search"}

# =========================
# UPLOAD WORKBOOK
# =========================

uploaded = files.upload()
INPUT_XLSX = list(uploaded.keys())[0]
print(f"Loaded workbook: {INPUT_XLSX}")

wb = load_workbook(INPUT_XLSX)
ws = wb.worksheets[0]

# Read antibody names from column 1
antibodies = []
for row_idx in range(2, ws.max_row + 1):
    value = ws.cell(row=row_idx, column=1).value
    if value is None:
        continue
    name = str(value).strip()
    if name:
        antibodies.append((row_idx, name))

print(f"Found {len(antibodies)} antibodies")
for row_idx, name in antibodies[:10]:
    print(row_idx, name)

# =========================
# OPENAI CLIENT
# =========================

client = OpenAI(api_key=OPENAI_API_KEY)

# =========================
# PROMPT BUILDER
# =========================

def build_prompt(antibody_name: str) -> str:
    return f"""
You are performing structured scientific data extraction.

Extract all publicly available clinical immunogenicity data for the therapeutic antibody "{antibody_name}".

Search the following sources in order of preference:

1. Peer-reviewed publications
2. FDA or EMA regulatory documents
3. Prescribing information
4. ClinicalTrials.gov results
5. Conference abstracts only if no peer-reviewed publication exists

Include only studies with at least one publicly reported immunogenicity result.

Exclude studies containing only:
- protocol descriptions
- planned ADA testing
- ADA sampling schedules
- immunogenicity endpoints without published results

Return JSON only in exactly this structure:

{{
  "antibody": "{antibody_name}",
  "trials": [
    {{
      "study": "string",
      "nct": "string",
      "phase": "string",
      "study_design": "string",
      "disease": "string",
      "treatment_cohort": "string",
      "dose": "string",
      "route": "string",
      "treatment_schedule": "string",
      "patients": "string",
      "baseline_ada": "string",
      "treatment_emergent_ada": "string",
      "treatment_boosted_ada": "string",
      "neutralizing_antibodies": "string",
      "collection": "string",
      "clinical_impact": "string",
      "notes": "string",
      "primary_source": "string"
    }}
  ]
}}

Rules:
- Use only explicitly reported information.
- Never infer missing values.
- If a field is unavailable write exactly: Not publicly available
- If no clinical consequences are discussed write exactly: Not publicly discussed.
- If no clinically meaningful association is reported write exactly: No clinically meaningful association was reported.
- Do not use numbered references such as [1], [2], etc.
- Do not use footnotes.
- Do not place references at the end of the response.
- All source links must appear only inside the primary_source field.
- If no eligible studies exist, return:
{{"antibody":"{antibody_name}","trials":[]}}
""".strip()

# =========================
# RESPONSE HELPERS
# =========================

def extract_text_from_response(response) -> str:
    """
    Robustly extract text from the Responses API output.
    """
    if hasattr(response, "output_text") and response.output_text:
        return response.output_text

    # Fallback for SDK variants
    try:
        parts = []
        for item in response.output:
            if getattr(item, "type", None) == "message":
                for c in item.content:
                    if getattr(c, "type", None) in ("output_text", "text"):
                        parts.append(getattr(c, "text", ""))
        text = "\n".join(parts).strip()
        if text:
            return text
    except Exception:
        pass

    return str(response)

def extract_json_object(text: str) -> dict:
    """
    Parse JSON from model output, stripping code fences if needed.
    """
    text = text.strip()

    # Remove code fences if present
    text = re.sub(r"^```(?:json)?\s*", "", text)
    text = re.sub(r"\s*```$", "", text)

    try:
        return json.loads(text)
    except Exception:
        pass

    # Try to extract the first full JSON object
    start = text.find("{")
    end = text.rfind("}")
    if start != -1 and end != -1 and end > start:
        candidate = text[start:end + 1]
        return json.loads(candidate)

    raise ValueError("Could not parse JSON from model output.")

def normalize_missing(value):
    if value is None:
        return "Not publicly available"
    if isinstance(value, str):
        s = value.strip()
        return s if s else "Not publicly available"
    return str(value)

def format_trial_block(trial: dict) -> str:
    """
    Convert one trial JSON object into the multiline cell text.
    """
    return "\n".join([
        f"Study: {normalize_missing(trial.get('study'))}",
        f"NCT: {normalize_missing(trial.get('nct'))}",
        f"Phase: {normalize_missing(trial.get('phase'))}",
        f"Study design: {normalize_missing(trial.get('study_design'))}",
        f"Disease: {normalize_missing(trial.get('disease'))}",
        f"Treatment cohort: {normalize_missing(trial.get('treatment_cohort'))}",
        f"Dose: {normalize_missing(trial.get('dose'))}",
        f"Route: {normalize_missing(trial.get('route'))}",
        f"Treatment schedule: {normalize_missing(trial.get('treatment_schedule'))}",
        f"Patients: {normalize_missing(trial.get('patients'))}",
        "",
        f"Baseline ADA: {normalize_missing(trial.get('baseline_ada'))}",
        f"Treatment-emergent ADA: {normalize_missing(trial.get('treatment_emergent_ada'))}",
        f"Treatment-boosted ADA: {normalize_missing(trial.get('treatment_boosted_ada'))}",
        f"Neutralizing antibodies: {normalize_missing(trial.get('neutralizing_antibodies'))}",
        "",
        f"Collection: {normalize_missing(trial.get('collection'))}",
        f"Clinical impact: {normalize_missing(trial.get('clinical_impact'))}",
        f"Notes: {normalize_missing(trial.get('notes'))}",
        f"Primary source: {normalize_missing(trial.get('primary_source'))}",
    ])

def research_antibody(antibody_name: str) -> dict:
    """
    Call OpenAI once for one antibody and return parsed JSON.
    """
    prompt = build_prompt(antibody_name)

    last_error = None
    for attempt in range(1, MAX_RETRIES + 1):
        try:
            response = client.responses.create(
                model=MODEL,
                input=prompt,
                tools=[WEB_SEARCH_TOOL],
            )

            raw_text = extract_text_from_response(response)
            data = extract_json_object(raw_text)

            if not isinstance(data, dict):
                raise ValueError("Top-level JSON is not an object.")
            if "trials" not in data or not isinstance(data["trials"], list):
                data = {"antibody": antibody_name, "trials": []}

            return data

        except Exception as e:
            last_error = e
            print(f"Retry {attempt}/{MAX_RETRIES} failed for {antibody_name}: {e}")
            if attempt < MAX_RETRIES:
                time.sleep(RETRY_SLEEP_SECONDS * attempt)

    print(f"Failed for {antibody_name}; writing no-trials message.")
    return {"antibody": antibody_name, "trials": []}

# =========================
# WORKBOOK HELPERS
# =========================

def find_antibody_row(ws, antibody_name):
    target = antibody_name.strip().lower()
    for row_idx in range(2, ws.max_row + 1):
        value = ws.cell(row=row_idx, column=1).value
        if value is None:
            continue
        if str(value).strip().lower() == target:
            return row_idx
    return None

def get_existing_note_columns(ws):
    cols = []
    for col_idx in range(1, ws.max_column + 1):
        header = ws.cell(row=1, column=col_idx).value
        if isinstance(header, str) and header.startswith(NOTE_HEADER_PREFIX):
            try:
                n = int(header.replace(NOTE_HEADER_PREFIX, "").strip())
                cols.append((n, col_idx))
            except ValueError:
                pass
    cols.sort(key=lambda x: x[0])
    return cols

def ensure_note_columns(ws, required_count):
    cols = get_existing_note_columns(ws)
    existing_count = len(cols)

    for n in range(existing_count + 1, required_count + 1):
        new_col = ws.max_column + 1
        ws.cell(row=1, column=new_col, value=f"{NOTE_HEADER_PREFIX}{n}")
        ws.column_dimensions[get_column_letter(new_col)].width = 70
        cols.append((n, new_col))

    cols.sort(key=lambda x: x[0])
    return [col_idx for _, col_idx in cols]

# =========================
# RESEARCH ALL ANTIBODIES
# =========================

results_by_antibody = {}
max_trials = 1

for _, antibody_name in tqdm(antibodies, desc="Researching antibodies"):
    result = research_antibody(antibody_name)
    trials = result.get("trials", [])
    results_by_antibody[antibody_name] = trials
    max_trials = max(max_trials, len(trials) if trials else 1)

print(f"Maximum trials found for any antibody: {max_trials}")

# =========================
# WRITE RESULTS INTO WORKBOOK
# =========================

note_columns = ensure_note_columns(ws, max_trials)

for row_idx, antibody_name in antibodies:
    trials = results_by_antibody.get(antibody_name, [])

    # Clear note cells for this row before writing
    for col_idx in note_columns:
        ws.cell(row=row_idx, column=col_idx).value = None

    if not trials:
        cell = ws.cell(row=row_idx, column=note_columns[0], value=NO_TRIALS_TEXT)
        cell.alignment = Alignment(wrap_text=True, vertical="top")
        ws.row_dimensions[row_idx].height = 30
        continue

    for i, trial in enumerate(trials):
        if i >= len(note_columns):
            break
        block = format_trial_block(trial)
        cell = ws.cell(row=row_idx, column=note_columns[i], value=block)
        cell.alignment = Alignment(wrap_text=True, vertical="top")

    ws.row_dimensions[row_idx].height = max(90, 22 * len(trials))

# =========================
# SAVE AND DOWNLOAD
# =========================

OUTPUT_XLSX = f"{Path(INPUT_XLSX).stem}_immunogenicity_updated.xlsx"
wb.save(OUTPUT_XLSX)
print(f"Saved to {OUTPUT_XLSX}")

files.download(OUTPUT_XLSX)
